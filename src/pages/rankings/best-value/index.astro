---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RankingEntries from '../../../components/RankingEntries.astro';
import { getRankingPageData } from '../../../data/utils/ranking-entries';
import { resolveCanonicalUrl } from '../../../config/seo';

const { ranking, entries } = await getRankingPageData('best-value');

const title = '性价比机场｜机场代理推荐｜机场荟';
const description = '从价格、流量、设备数等实际使用条件出发，说明机场荟如何评估机场代理服务商的性价比，而不是单纯比价格。';

// 价格对照直接汇总 providers.json 里已经记录的资料，不合并、不取平均——
// 有冲突的地方原样并列呈现，链接到服务商详情页查看完整资料与来源日期。
// 这份表只覆盖本站对比范围里"至少有一条价格信息"的品牌，资料完全空白
// 的补充品牌（可信云/一翻云/隐形人等）不会被硬凑进来充数，见下方说明。
