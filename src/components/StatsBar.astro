---
interface Props {
  providerCount: number;
  rankingCount: number;
  articleCount: number;
}

const { providerCount, rankingCount, articleCount } = Astro.props;

// "45+" 这类展示格式：向下取整到 5 的倍数，避免每加一篇文章就要改这里的文案，
// 同时保证数字不会比真实数量更大（不会虚报）。
const articleDisplay = `${Math.floor(articleCount / 5) * 5}+`;

// 这里原来（沿用自机场吧/更早的机场荟草稿）有第四项"10,000+ 用户信赖"，
// 但本站没有账号系统或访问统计能支撑这个数字，是纯编造的社会认同数字，
// 直接违反本项目自己在 CLAUDE.md 第5节定的"不虚构用户评价/数据来源"规则，
// 已经删除，不用另一个编出来的数字替换——没有真实数据支撑的指标，宁可
// 不展示。如果之后接入了真实的站内数据面板（/internal-stats 的浏览量/
// 点击量），可以考虑换成那份数据里站长愿意公开的真实指标。
const stats = [
  { icon: '/assets/icons/stats/providers.svg', number: String(providerCount), lineA: '已收录服务商', lineB: '纳入横向对比' },
  { icon: '/assets/icons/stats/rankings.svg', number: String(rankingCount), lineA: '对比榜单', lineB: '不同维度切入' },
  { icon: '/assets/icons/stats/articles.svg', number: articleDisplay, lineA: '原创文章', lineB: '持续更新' },
];
---

<div class="stat-strip">
  {
    stats.map((stat) => (
      <div class="stat-strip__item">
        <span class="stat-strip__icon" aria-hidden="true">
          <img src={stat.icon} alt="" width="28" height="28" />
        </span>
        <span class="stat-strip__text">
          <span class="stat-strip__number">{stat.number}</span>
          <span class="stat-strip__label">
            {stat.lineA}
            <br />
            {stat.lineB}
          </span>
        </span>
      </div>
    ))
  }
</div>
